
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="theme-color" content="#071a33">
  <meta name="description" content="Bertrand Helios — Élections du Conseil National de l'Ordre des infirmiers 2026">
  <title>Bertrand Helios — Élections 2026</title>

  <style>
    :root {
      --navy: #071a33;
      --blue: #1677c8;
      --text: #172337;
      --muted: #667085;
      --border: #dce5ee;
      --shadow: 0 16px 40px rgba(4, 20, 42, .14);

      --green-bg: #edf8f1;
      --green-border: #c8e7d2;
      --green-icon: #238653;

      --orange-bg: #fff5e9;
      --orange-border: #f1d4ad;
      --orange-icon: #d97820;

      --red-bg: #fff0f0;
      --red-border: #f0cccc;
      --red-icon: #c65353;
    }

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      margin: 0;
      background: linear-gradient(
        180deg,
        #f4f8fc 0%,
        #ffffff 45%,
        #f4f8fc 100%
      );
      color: var(--text);
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI",
        Roboto, Helvetica, Arial, sans-serif;
    }

    .page {
      width: min(900px, calc(100% - 24px));
      margin: auto;
      padding: 30px 0 50px;
    }

    /* EN-TÊTE */

    .header {
      text-align: center;
      margin-bottom: 20px;
    }

    .header h1 {
      margin: 0;
      color: var(--navy);
      font-size: clamp(2.2rem, 8vw, 4rem);
      line-height: 1;
      letter-spacing: -.045em;
      font-weight: 900;
    }

    .header h2 {
      margin: 10px auto 0;
      color: var(--blue);
      font-size: clamp(1rem, 3.5vw, 1.3rem);
      line-height: 1.35;
      font-weight: 800;
    }

    /* PROFESSION DE FOI */

    .faith-button {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 11px;
      width: 100%;
      min-height: 65px;
      margin: 0 auto 13px;
      padding: 13px 18px;
      border-radius: 17px;
      color: white;
      background: linear-gradient(135deg, #075da6, #1687df);
      text-decoration: none;
      box-shadow: 0 10px 28px rgba(4, 20, 42, .16);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .faith-button:hover {
      transform: translateY(-3px);
      box-shadow: var(--shadow);
    }

    .faith-icon {
      font-size: 1.6rem;
    }

    .faith-text {
      display: flex;
      flex-direction: column;
      gap: 2px;
      text-align: left;
    }

    .faith-title {
      font-size: 1.22rem;
      font-weight: 950;
      letter-spacing: .02em;
    }

    .faith-subtitle {
      font-size: .76rem;
      opacity: .85;
      font-weight: 600;
    }

    /* AIDE AU VOTE */

    .vote-info {
      width: 100%;
      margin: 0 auto 24px;
      padding: 20px 21px;
      background: white;
      border: 1px solid var(--border);
      border-radius: 20px;
      box-shadow: 0 8px 25px rgba(4, 20, 42, .07);
    }

    .vote-header {
      text-align: center;
      margin-bottom: 16px;
    }

    .vote-header h2 {
      margin: 0;
      color: var(--navy);
      font-size: clamp(1.15rem, 4vw, 1.4rem);
      line-height: 1.25;
      font-weight: 900;
    }

    /* Nouveau rappel : plus foncé et plus visible */

    .vote-header p {
      margin: 10px 0 0;
      color: var(--navy);
      font-size: .88rem;
      line-height: 1.5;
      font-weight: 800;
    }

    .mail-search-title {
      display: block;
      margin-top: 7px;
      color: var(--navy);
      font-weight: 900;
    }

    .mail-search-phrase {
      display: inline-block;
      margin-top: 4px;
      color: #071a33;
      font-weight: 900;
    }

    .steps {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .step-link {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-height: 150px;
      padding: 16px 12px;
      color: inherit;
      text-decoration: none;
      text-align: center;
      border-radius: 17px;
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .step-link:hover {
      transform: translateY(-3px);
      box-shadow: 0 9px 22px rgba(4, 20, 42, .10);
    }

    .step-green {
      background: var(--green-bg);
      border: 1px solid var(--green-border);
    }

    .step-green .step-number {
      background: var(--green-icon);
    }

    .step-orange {
      background: var(--orange-bg);
      border: 1px solid var(--orange-border);
    }

    .step-orange .step-number {
      background: var(--orange-icon);
    }

    .step-red {
      background: var(--red-bg);
      border: 1px solid var(--red-border);
    }

    .step-red .step-number {
      background: var(--red-icon);
    }

    .step-number {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 30px;
      height: 30px;
      margin-bottom: 10px;
      border-radius: 50%;
      color: white;
      font-size: .8rem;
      font-weight: 900;
    }

    .step-icon {
      font-size: 1.4rem;
      margin-bottom: 8px;
    }

    .step-title {
      display: block;
      color: var(--navy);
      font-size: .88rem;
      line-height: 1.35;
      font-weight: 900;
    }

    .step-description {
      display: block;
      margin-top: 8px;
      color: #667085;
      font-size: .76rem;
      line-height: 1.35;
      font-weight: 600;
    }

    .simple {
      margin: 16px 0 0;
      color: var(--navy);
      text-align: center;
      font-size: .84rem;
      font-weight: 800;
    }

    /* AFFICHE */

    .poster {
      display: block;
      width: 100%;
      height: auto;
      margin: 0 auto;
      border-radius: 20px;
      box-shadow: var(--shadow);
    }

    /* MOBILE */

    @media (max-width: 680px) {
      .page {
        width: calc(100% - 16px);
        padding-top: 18px;
      }

      .header {
        margin-bottom: 17px;
      }

      .header h1 {
        font-size: clamp(2rem, 10vw, 3rem);
      }

      .header h2 {
        font-size: 1rem;
      }

      .faith-button {
        min-height: 63px;
        margin-bottom: 11px;
        border-radius: 15px;
      }

      .faith-icon {
        font-size: 1.5rem;
      }

      .faith-title {
        font-size: 1.08rem;
      }

      .faith-subtitle {
        font-size: .72rem;
      }

      .vote-info {
        width: 100%;
        padding: 18px 14px;
        border-radius: 17px;
      }

      .vote-header h2 {
        font-size: 1.1rem;
      }

      .vote-header p {
        font-size: .82rem;
        line-height: 1.45;
      }

      .steps {
        grid-template-columns: 1fr;
        gap: 8px;
      }

      .step-link {
        display: grid;
        grid-template-columns: 30px 34px minmax(0, 1fr);
        column-gap: 8px;
        align-items: center;
        min-height: 72px;
        padding: 10px 11px;
        text-align: left;
      }

      .step-number {
        margin: 0;
      }

      .step-icon {
        margin: 0;
        text-align: center;
      }

      .step-title,
      .step-description {
        grid-column: 3;
      }

      .step-title {
        font-size: .84rem;
        line-height: 1.3;
      }

      .step-description {
        margin-top: 4px;
        font-size: .74rem;
        line-height: 1.3;
      }

      .simple {
        font-size: .8rem;
      }

      .poster {
        border-radius: 15px;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      * {
        transition: none !important;
        scroll-behavior: auto !important;
      }
    }
  </style>
</head>

<body>
  <main class="page">

    <!-- EN-TÊTE -->

    <header class="header">
      <h1>BERTRAND HELIOS</h1>
      <h2>
        Elections du Conseil National de l'Ordre des infirmiers 2026
      </h2>
    </header>

    <!-- PROFESSION DE FOI -->

    <a
      class="faith-button"
      href="Profession-de-foi-Bertrand-HELIOS.pdf"
      target="_blank"
      rel="noopener noreferrer"
    >
      <span class="faith-icon">📄</span>

      <span class="faith-text">
        <span class="faith-title">MA PROFESSION DE FOI</span>
        <span class="faith-subtitle">
          Mes engagements pour les infirmiers
        </span>
      </span>
    </a>

    <!-- AIDE AU VOTE -->

    <section class="vote-info">
      <div class="vote-header">
        <h2>🔑 Besoin d’aide pour voter ?</h2>

        <p>
          👇 Cliquez sur l’étape qui correspond à votre situation.
          <span class="mail-search-title">
            📩 Avant de demander un nouveau code, vérifiez votre boîte mail,
            vos spams et vos messages supprimés.
          </span>
          <span class="mail-search-title">
            🔎 Dans la recherche de vos e-mails, tapez :
          </span>
          <span class="mail-search-phrase">
            « Élection du Conseil national de l’Ordre des infirmiers 2026 »
          </span>
        </p>
      </div>

      <div class="steps">

        <!-- ÉTAPE 1 -->

        <a
          class="step-link step-green"
          href="https://onielections2026.vote.voxaly.com/identification"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="step-number">1</span>
          <span class="step-icon">🗳️</span>
          <span class="step-title">
            J’ai mon code d’accès pour le vote
          </span>
          <span class="step-description">
            Je clique ici pour voter.
          </span>
        </a>

        <!-- ÉTAPE 2 : BOUTON CONSERVÉ -->

        <a
          class="step-link step-orange"
          href="https://onielections2026.vote.voxaly.com/reassort/codeacces"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="step-number">2</span>
          <span class="step-icon">🔑</span>
          <span class="step-title">
            J’ai perdu mon code d’accès
          </span>
          <span class="step-description">
            Je clique ici pour le récupérer.
          </span>
        </a>

        <!-- ÉTAPE 3 -->

        <a
          class="step-link step-red"
          href="https://espace-membres.ordre-infirmiers.fr"
          target="_blank"
          rel="noopener noreferrer"
        >
          <span class="step-number">3</span>
          <span class="step-icon">⚕️</span>
          <span class="step-title">
            Je ne connais plus mon numéro ordinal
          </span>
          <span class="step-description">
            Je clique ici pour le retrouver.
          </span>
        </a>

      </div>

      <p class="simple">
        ⏱️ Quelques minutes suffisent pour voter Bertrand HELIOS.
        <strong>Merci pour votre participation !</strong>
      </p>
    </section>

    <!-- AFFICHE -->

    <img
      class="poster"
      src="affiche-campagne.jpg"
      alt="Affiche de campagne de Bertrand Helios"
    >

  </main>
</body>
</html>
